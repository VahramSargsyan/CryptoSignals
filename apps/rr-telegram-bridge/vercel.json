{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram.js": {
      "maxDuration": 10
    },
    "api/rr-scheduler.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/rr-scheduler",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/rr-scheduler",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/rr-scheduler",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/rr-scheduler",
      "schedule": "50 19 * * *"
    }
  ]
}
